{
  "name": "codex-ssh-desktop",
  "version": "0.4.0",
  "scripts": {
    "build:server": "tsc -p src/server",
    "build:browser": "vite build --config vite.browser.config.ts",
    "prepare:desktop": "node desktop/prepare.mjs",
    "start": "electron viewer",
    "test": "npm run build:server && node --test test/*.test.cjs && python3 -B -m unittest discover -s test -p \"*_test.py\" && node desktop/test-access.cjs",
    "test:desktop": "node desktop/test-ownership.mjs && node desktop/test-goal-resume.mjs && node desktop/test-queued-delete.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "test:accounts-ui": "electron test/accounts-window.smoke.cjs",
    "test:updates-ui": "electron test/updates-window.smoke.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RedAvocado/codex-ssh-desktop.git"
  },
  "author": "Codex SSH Desktop contributors",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.8.5",
    "glob": "^13.0.6",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.3.0"
  },
  "private": true,
  "description": "A separate macOS desktop viewer for Codex over SSH.",
  "engines": {
    "node": ">=24"
  }
}
